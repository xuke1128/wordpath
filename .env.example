# 词径 WordPath 环境变量样例：复制为 .env 后按需修改。
# 真实密钥只放环境变量，切勿提交到仓库。

# 服务端口（默认 8787）
PORT=8787

# SQLite 数据库文件路径（默认 ./data/wordpath.db，目录会自动创建）
WORDPATH_DB=./data/wordpath.db

# 微信授权回调后跳转的前端源（生产环境改为你的 HTTPS 域名）
FRONTEND_ORIGIN=http://localhost:5173

# ---- 微信网页授权登录（可选）----
# 以下三项【全部】配置后，登录页才会显示「微信登录」入口；
# 留空则仅提供「体验登录」（mock）。
# 注意：真实微信登录需要微信开放平台审核通过的网站应用 appid/secret，
# 且回调域名需与开放平台配置一致（需 HTTPS）。
# WECHAT_APPID=
# WECHAT_SECRET=
# WECHAT_REDIRECT_URI=https://your-domain.com/api/auth/wechat/callback

# 运行环境（production 时由服务端托管前端构建产物，单端口部署）
# NODE_ENV=production
