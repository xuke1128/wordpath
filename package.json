{
  "name": "wordpath",
  "version": "1.1.0",
  "description": "词径 WordPath —— 按学段选词书、用间隔重复科学抗遗忘的背单词 Web 应用",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "npm run typecheck && npm run build:server && npm run build:client",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "lint": "eslint .",
    "start": "NODE_ENV=production node dist/server/index.js",
    "test": "vitest run",
    "seed": "tsx scripts/seed.ts",
    "wordbook:validate": "tsx scripts/wordbook.ts validate",
    "wordbook:import": "tsx scripts/wordbook.ts import"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/static": "^7.0.4",
    "fastify": "^4.29.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^5.4.11",
    "vitest": "^3.2.7"
  }
}
